# ===== 听课搭子 配置 =====
# 安装时会自动复制成 .env,用记事本打开 .env 修改,改完重启「启动.bat」生效。

# 1) DeepSeek API Key(翻译、总结、提问提醒都靠它)。获取:https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 2) 你的课程(逗号分隔;第一个词是课号,用作文件夹名,也用来找「术语」文件夹里的 <课号>.txt)
COURSES=COMP0001 示例课程,其他

# 3) 笔记存哪。填了 Obsidian 库路径就存进库里的 RECORD_SUBDIR;留空就存到程序旁边的「课堂记录」文件夹
#    例:OBSIDIAN_VAULT=D:\Obsidian Vault
OBSIDIAN_VAULT=
RECORD_SUBDIR=课堂记录

# 4) 提问提醒默认关(1=打开)。它是学习辅助:正式考试、口语评估时请关闭
AUTO_QA=0

# 5) 语音识别(一般不用改):auto = 有 NVIDIA 显卡用 large-v3-turbo,没有就用 CPU + small.en
WHISPER_DEVICE=auto
WHISPER_MODEL=
WHISPER_COMPUTE=

# 声音太小识别不到 → 调小(如 0.004);噪音误触发 → 调大(如 0.015)
SILENCE_RMS=0.008
PORT=5000

# 在中国大陆下载语音模型很慢时,去掉下一行开头的 # 用镜像
# HF_ENDPOINT=https://hf-mirror.com
