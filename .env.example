# ===== 听课搭子 配置 =====
# 安装时会自动复制成 .env。模型和 key 建议直接在界面左下「⚙ 设置」里填,会写回这里。

# 1) 模型提供商(界面设置页会写这几行)。DeepSeek key:https://platform.deepseek.com/api_keys
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 2) 你的课程(逗号分隔;第一个词是课号,用作文件夹名,也用来找「术语」文件夹里的 <课号>.txt)
COURSES=COMP0001 示例课程,其他

# 3) 笔记存哪。填了 Obsidian 库路径就存进库里;留空就存到程序旁边的「课堂记录」文件夹
#    RECORD_SUBDIR = 课堂记录放在库的哪个子文件夹(每门课再分一层);COURSE_SUBDIR = 每门课的知识页(周页、AI问答.md)放哪
#    例:OBSIDIAN_VAULT=D:\Obsidian Vault   RECORD_SUBDIR=课程/课堂记录   COURSE_SUBDIR=课程
OBSIDIAN_VAULT=
RECORD_SUBDIR=
COURSE_SUBDIR=

# 4) 提问提醒默认关(1=打开)。它是学习辅助:正式考试、口语评估时请关闭
AUTO_QA=0

# 5) 「了解我」默认关(1=打开)。开之前把 profile/我.example.md 复制成 我.md 填一下
CONTEXT_MODE=0

# 6) 语音识别(一般不用改):auto = 有 NVIDIA 显卡用 large-v3-turbo,没有就用 CPU + small.en
WHISPER_DEVICE=auto
WHISPER_MODEL=
WHISPER_COMPUTE=

# 声音太小识别不到 → 调小(如 0.004);噪音误触发 → 调大(如 0.015)
SILENCE_RMS=0.008
PORT=5000
# 没插电时:低于 20% 提醒,低于 8% 自动结束保存
BATTERY_WARN=20
BATTERY_STOP=8

# 在中国大陆下载语音模型很慢时,去掉下一行开头的 # 用镜像
# HF_ENDPOINT=https://hf-mirror.com
