# 复制成 .env 再填。所有 key 只存在你自己的服务器上。
GROQ_API_KEY=            # 公共语音识别 key:owner 账号用 + 新用户试用。https://console.groq.com 免费申请。留空=不开放试用
DEEPSEEK_API_KEY=        # 公共翻译 key(同上):https://platform.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
TRIAL_SECONDS=0          # 让没填 key 的新用户用你的公共 key 试用多少秒。0 = 不开放(推荐):每个人在页面第 1 步填自己的 key,页面里有录屏教他们拿
ACCESS_TOKEN=            # 你自己(owner)的钥匙,随便起一串长的:https://你的域名/live/?k=这里 。其他人在页面上「开始使用」各自拿钥匙
PUBLIC_BASE_URL=         # 对外地址,如 https://tingke.example.com(给用户显示 WebDAV 地址用)
PORT=8095
VAULT_DIR=               # owner 的记录存哪(留空=程序目录 records/owner;建议指到你的 Obsidian 同步目录)
RECORD_SUBDIR=课堂记录    # owner 记录放在 VAULT_DIR 下的哪个子目录
COURSES=COMP0001 示例课程,其他   # owner 的课,逗号分隔,格式「课号 名称」;其他用户在页面里自己填
TERM_START=2026-09-21    # 学期第一周的周一,用来算「第几周」
DAV_ROOT=/srv/udav       # 托管同步:每个用户一个子目录,nginx 的 /udav/<uid>/ 指到这里(见 deploy/setup-dav.sh)
DAV_AUTH_DIR=/srv/udav-auth   # 每个用户一份 htpasswd,只给 nginx 读
TRIAL_DAILY_CAP=3600     # 所有试用用户一天合计上限(保护你的 Groq 免费档)
