# 复制成 .env 再填。所有 key 只存在你自己的服务器上。
GROQ_API_KEY=            # 语音识别:https://console.groq.com 免费申请(有免费额度)
DEEPSEEK_API_KEY=        # 翻译 / 总结 / 提问:https://platform.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ACCESS_TOKEN=            # 网页链接里的钥匙,随便起一串长的,别外传:  https://你的域名/live/?k=这里
PORT=8095
RECORDS_DIR=             # 记录存哪(留空=程序目录下 records/;建议指到你的 Obsidian 同步目录,如 WebDAV 根)
RECORD_SUBDIR=课堂记录    # 记录放在 RECORDS_DIR 下的哪个子目录,再按课号分文件夹
COURSES=COMP0001 示例课程,其他   # 你的课,逗号分隔,格式「课号 名称」
TERM_START=2026-09-21    # 学期第一周的周一,用来算「第几周」
